{
  "name": "arenacue-control",
  "version": "1.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:login": "eas login",
    "build:apk": "eas build -p android --profile preview",
    "build:aab": "eas build -p android --profile production",
    "submit:android": "eas submit -p android --profile production",
    "legal": "node ../scripts/npm-production-license-inventory.mjs --lock package-lock.json --out LEGAL_THIRD_PARTY_NPM.md --title \"ArenaCue Mobile — third-party npm-packages (productie)\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "eas-cli": "^18.11.0"
  }
}
