// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id             String   @id @default(cuid())
  name           String
  shortName      String
  logoPath       String?
  primaryColor   String
  secondaryColor String
  players        Player[]
  homeMatches    Match[]  @relation("HomeTeam")
  awayMatches    Match[]  @relation("AwayTeam")
}

model Player {
  id              String  @id @default(cuid())
  teamId          String
  team            Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  number          Int
  firstName       String
  lastName        String
  position        String?
  photoPath       String?
  isCoach         Boolean @default(false)
  goalMediaId     String?
  goalVideoPath   String?
  subImagePath    String?
  lineupVideoPath String?
}

model Match {
  id              String       @id @default(cuid())
  homeTeamId      String
  awayTeamId      String
  homeTeam        Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam        Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoffAt       DateTime?
  /// Optioneel: vaste matchsponsor — automatisch fullscreen vanaf 5 min voor kickoffAt tot aftrap (SETUP/PREMATCH).
  matchSponsorMediaId String?
  matchSponsorMedia   MediaItem? @relation("MatchSponsorMedia", fields: [matchSponsorMediaId], references: [id], onDelete: SetNull)
  halfDurationSec Int          @default(2700)
  halfBreakSec    Int          @default(900)
  status          String       @default("SETUP")
  homeScore       Int          @default(0)
  awayScore       Int          @default(0)
  /// JSON string[] — spelers op het veld (thuis); bij leeg/null vult server default 11.
  homeFieldPlayerIdsJson String?
  /// JSON string[] — spelers op het veld (uit).
  awayFieldPlayerIdsJson String?
  events          MatchEvent[]
  createdAt       DateTime     @default(now())
}

model MatchEvent {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type        String
  minute      Int
  addedTime   Int      @default(0)
  teamId      String?
  playerInId  String?
  playerOutId String?
  note        String?
  createdAt   DateTime @default(now())
}

model MediaItem {
  id          String         @id @default(cuid())
  type        String
  path        String
  title       String
  durationSec Int
  sponsorName String?
  sponsorId   String?
  sponsor     Sponsor?       @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  active      Boolean        @default(true)
  /// VIDEO: op het display-geluid aan (indien het bestand audio bevat).
  playAudio   Boolean        @default(false)
  /// JSON array met sponsor-fases waarvoor dit media-item mag draaien. Null/leeg = alle fases.
  sponsorPhaseTagsJson String?
  createdAt   DateTime       @default(now())
  playlistItems PlaylistItem[]
  matchSponsorForMatches Match[] @relation("MatchSponsorMedia")
  scheduledCues ScheduledMediaCue[]
}

model ScheduledMediaCue {
  id          String    @id @default(cuid())
  mediaId     String
  media       MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  matchStatus String
  triggerSec  Int
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Sponsor {
  id                String      @id @default(cuid())
  name              String
  active            Boolean     @default(true)
  prematchSeconds   Int         @default(0)
  matchSeconds      Int         @default(0)
  matchFirstHalfSeconds   Int  @default(0)
  matchSecondHalfSeconds  Int  @default(0)
  halftimeSeconds   Int         @default(0)
  imageDefaultSec   Int         @default(10)
  /// Optioneel: eigen seconden vol scorebord vs. sponsorbeeld (leeg = standaard uit Setup).
  firstHalfScoreboardSec   Int?
  firstHalfSponsorSec      Int?
  halftimeScoreboardSec    Int?
  halftimeSponsorSec       Int?
  secondHalfScoreboardSec  Int?
  secondHalfSponsorSec     Int?
  createdAt         DateTime    @default(now())
  media             MediaItem[]
}

model Playlist {
  id    String         @id @default(cuid())
  name  String
  slot  String         @unique
  items PlaylistItem[]
}

model PlaylistItem {
  id                  String    @id @default(cuid())
  playlistId          String
  playlist            Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaId             String
  media               MediaItem @relation(fields: [mediaId], references: [id])
  order               Int
  durationOverrideSec Int?
}

model DisplayState {
  id                 Int       @id @default(1)
  mode               String    @default("IDLE")
  matchId            String?
  activePlayerId     String?
  activeSubOutId     String?
  activeSubInId      String?
  activeGoalScorerId String?
  activeMediaId      String?
  /// JSON-array { teamId, playerOutId, playerInId }[] — volgende wissels na de huidige.
  substitutionQueueJson String @default("[]")
  timerRunning       Boolean   @default(false)
  timerStartedAt     DateTime?
  timerBaseSec       Int       @default(0)
  externalCaptureSourceId  String?
  externalCaptureToDisplay Boolean @default(false)
  /// Modus om naar terug te keren na BLACKOUT (toggle).
  blackoutResumeMode String?
  updatedAt          DateTime  @updatedAt
}

model AppSettings {
  id                       Int     @id @default(1)
  homeTeamId               String?
  goalIntroVideoPath       String?
  /// GOAL +1 gedrag: thuis standaard visual, uit standaard enkel score.
  goalVisualHomeEnabled    Boolean @default(true)
  goalVisualAwayEnabled    Boolean @default(false)
  /// Oud; alleen nog aanwezig in bestaande SQLite DB, migratie in electron/runtime.
  matchLiveScoreboardSec   Int     @default(45)
  matchLiveSponsorSec      Int     @default(15)
  firstHalfScoreboardSec   Int     @default(45)
  firstHalfSponsorSec      Int     @default(15)
  halftimeScoreboardSec    Int     @default(30)
  halftimeSponsorSec       Int     @default(15)
  secondHalfScoreboardSec  Int     @default(45)
  secondHalfSponsorSec     Int     @default(15)
  liveCycleLegacyImported  Int     @default(0)
  /// JSON ScoreboardTheme — kleuren, lettertype, afmetingen, volgorde blokken scorebord.
  scoreboardThemeJson      String?
}
