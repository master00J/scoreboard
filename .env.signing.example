# Kopieer naar .env.signing (niet committen).
# App Registration + rol: Artifact Signing Certificate Profile Signer.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Artifact Signing-account (Azure-portaal)
AZURE_SIGNING_ENDPOINT=https://neu.codesigning.azure.net/
AZURE_SIGNING_ACCOUNT=arenacue-signing-be
AZURE_SIGNING_PROFILE=ArenaCuePublic

# Exact subject van het certificaat (optioneel, voor later electron-updater)
# AZURE_SIGNING_PUBLISHER_NAME=CN=Sound & Vision, O=Sound & Vision, C=BE
