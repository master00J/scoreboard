{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "../electron-dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "resolveJsonModule": true
  },
  "include": [
    "../electron/**/*.ts",
    "../lib/desktop-bridge.ts",
    "../lib/sponsor-telemetry.ts",
    "../lib/prisma.ts",
    "../lib/timer.ts",
    "../lib/validation/**/*.ts",
    "../server/handlers.ts"
  ],
  "exclude": ["../node_modules"]
}
