{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "electron-window.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "Website",
    "version home 28-08",
    "MobileApp",
    "demo 14-09",
    "dist",
    "dist-*",
    "electron-dist",
    "renderer-dist",
    "web-demo-dist",
    "legal-dist"
  ]
}
