{
  "expo": {
    "name": "ArenaCue Control",
    "slug": "arenacue-control",
    "description": "Mobiele remote-control companion voor de ArenaCue desktopsoftware.",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "arenacue",
    "icon": "./assets/icon.png",
    "newArchEnabled": false,
    "updates": {
      "checkAutomatically": "NEVER"
    },
    "assetBundlePatterns": [
      "assets/*"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070f"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Camera nodig om de ArenaCue desktop QR-code te scannen.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "be.arenacue.control",
      "versionCode": 9,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070f"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=be.arenacue.control"
    },
    "extra": {
      "eas": {
        "projectId": "272a2d4e-db9e-4841-9015-756a41aca195"
      }
    }
  }
}
